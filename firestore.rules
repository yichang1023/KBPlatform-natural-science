// =====================================================================
//  Firestore 安全規則 — 專案 kb-forum(新版平台專用)
//  貼上位置:Firebase 控制台 → Firestore Database → 規則 → 取代全部內容 → 發布
//
//  【說明】新版採「簡易帳號」:帳號與(加密後的)密碼存在資料庫裡,網頁不需要 Firebase 登入。
//  因此規則只能限制「可以寫什麼格式、不能刪除」,無法限制「是誰在寫」。適合小型研究班級使用;
//  日後若要對外公開或規模變大,請改用 Firebase Authentication。
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 使用者、班級、組別、討論區、回收桶、設定、貼文(每 500 則一份文件)、ASRA 反思紀錄
    match /kb_v2/{docId} {
      allow read: if true;
      allow create, update: if (docId in ['users', 'classes', 'groups', 'topics', 'trash', 'settings']
                                || docId.matches('nodes__[A-Za-z0-9_-]+__[0-9]+'))
        && request.resource.data.keys().hasOnly(['items', 'value'])
        && (!('items' in request.resource.data) || (request.resource.data.items is map && request.resource.data.items.size() <= 2000));
      // ASRA 反思與計畫紀錄:每位學生一份文件 asra__<學號>,內容 { items: { 紀錄編號: 紀錄 } }
      // 只能新增紀錄;既有的紀錄不能被修改或刪除(保存質性研究資料的原貌與日期)
      allow create: if docId.matches('asra__[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 2000;
      allow update: if docId.matches('asra__[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 2000
        && request.resource.data.items.diff(resource.data.items).unchangedKeys().size() == resource.data.items.size();
      allow delete: if false;
    }

    // 發言附件(照片/錄音):一個檔案一份文件 kb_v2_media/<編號>,內容是壓縮後的 data URL。
    // 只能新增、不能改、不能刪;單檔 data URL 上限 900000 字元(Firestore 單份文件上限約 1MB)。
    // 讀取是公開的(和其他資料一樣,知道網址的人看得到),請提醒小朋友不要拍到臉、名牌、住址。
    match /kb_v2_media/{mid} {
      allow read: if true;
      allow create: if mid.matches('m[A-Za-z0-9_-]{6,60}')
        && request.resource.data.keys().hasOnly(['d', 'm', 't', 'w', 'h', 'dur'])
        && request.resource.data.d is string
        && request.resource.data.d.size() <= 900000
        && request.resource.data.m is string
        && request.resource.data.m.matches('(image|audio)/[a-z0-9.+-]+');
      allow update, delete: if false;
    }

    // ASRA 學習單資料包(老師的瀏覽器先用密碼加密,這裡只有密文):
    //   kb_v2_asrapack/<編號>      { c: 密文(base64), iv }      密文上限 900000 字元(Firestore 單份文件約 1MB)
    //   kb_v2_asrapack_idx/<編號>  { n 名稱, t 時間, k 'pack'|'del', a 學生數, r 回答數, s salt, i 迭代數, sz 大小 }
    // 兩個都只能新增、不能改、不能刪;「覆蓋」「移除」都是再新增一筆新的。
    // 讀取是公開的,但內容是 AES-256-GCM 密文,沒有老師的密碼看不到;名稱與人數是明文,檔名請不要放學生姓名。
    match /kb_v2_asrapack/{pid} {
      allow read: if true;
      allow create: if pid.matches('k[a-z0-9_]{8,40}')
        && request.resource.data.keys().hasOnly(['c', 'iv'])
        && request.resource.data.c is string
        && request.resource.data.c.size() <= 900000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() <= 40;
      allow update, delete: if false;
    }
    match /kb_v2_asrapack_idx/{pid} {
      allow read: if true;
      allow create: if pid.matches('k[a-z0-9_]{8,40}')
        && request.resource.data.keys().hasOnly(['n', 't', 'k', 'a', 'r', 's', 'i', 'sz'])
        && request.resource.data.n is string
        && request.resource.data.n.size() <= 120
        && request.resource.data.k in ['pack', 'del']
        && request.resource.data.t is number
        && request.resource.data.s is string
        && request.resource.data.s.size() <= 40;
      allow update, delete: if false;
    }

    // 稽核紀錄:每天一份文件,只能新增與更新
    match /kb_v2_audit/{day} {
      allow read: if true;
      allow create, update: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 5000;
      allow delete: if false;
    }

    // AI 金鑰(老師存到雲端、讓學生在家也能用 AI):瀏覽器完全不能讀寫。
    // 只有 Vercel 上的伺服器程式(用 Firebase 服務帳戶,不受這些規則限制)才存取 kb_secret/ai。
    match /kb_secret/{docId} {
      allow read, write: if false;
    }

    // 其他所有路徑一律關閉
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
